# 复制为 .env 并填入（或直接设置系统环境变量）

# === LLM（OpenAI 兼容；默认 DeepSeek）===
# DeepSeek 官方：base_url=https://api.deepseek.com/v1  model=deepseek-chat
# 通义千问兼容：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# OpenAI：      base_url=https://api.openai.com/v1      model=gpt-4o-mini
VNOTES_LLM_BASE_URL=https://api.deepseek.com/v1
VNOTES_LLM_API_KEY=sk-你的key
VNOTES_LLM_MODEL=deepseek-chat

# === 转写后端（三选一）===
# faster-whisper：本地轻量（推荐，不装 torch，模型下载到 D 盘）
# groq：云端 API（零空间，极快，需 Groq Key）
# openai-whisper：原方案（需 torch，占空间大）
VNOTES_TRANSCRIBE_BACKEND=faster-whisper

# --- faster-whisper 配置 ---
VNOTES_WHISPER_DEVICE=cuda
VNOTES_WHISPER_MODEL_ZH=turbo
VNOTES_WHISPER_MODEL_EN=small.en
# 模型下载目录（默认 D:/vnotes_models，省 C 盘空间）
# VNOTES_WHISPER_MODEL_DIR=D:/vnotes_models
# 国内网络建议使用 Hugging Face 镜像
VNOTES_HF_ENDPOINT=https://hf-mirror.com
# 长音频本地转写分片秒数，降低内存压力
VNOTES_TRANSCRIBE_CHUNK_SECONDS=300
# Vosk 低内存离线兜底模型目录
VNOTES_VOSK_MODEL_DIR=D:/vnotes_models/vosk-model-small-cn-0.22

# --- Groq 配置（选 groq 后端时填）---
# 注册地址：https://console.groq.com（免费额度充足）
VNOTES_GROQ_API_KEY=
VNOTES_GROQ_MODEL=whisper-large-v3-turbo

# === 阿里云 Paraformer（国内直连转写，选 paraformer 后端时填）===
# 注册地址：https://dashscope.console.aliyun.com
VNOTES_DASHSCOPE_API_KEY=
VNOTES_PARAFORMER_MODEL=paraformer-v2

# === 长视频优化 ===
# 分级摘要（超长视频先摘要再分析）
VNOTES_HIERARCHICAL_SUMMARY=true
# 断点恢复（每块分析结果存盘，中断后可续）
VNOTES_CHECKPOINT_ENABLED=true
# 分析分块并行线程数
VNOTES_ANALYZE_MAX_WORKERS=4
# 单次处理最大视频时长（秒），超限启用分级摘要
VNOTES_MAX_DURATION=7200
# SVG 并行线程数
VNOTES_SVG_MAX_WORKERS=6

# === Web UI ===
# 服务端口（默认 7458）
VNOTES_SERVER_PORT=7458

# === B站 cookies ===
# 浏览器名（chrome / edge / firefox / brave），工具用 --cookies-from-browser 读取登录态
VNOTES_COOKIES_BROWSER=chrome
# 或者指定 Netscape 格式 cookies.txt 文件路径（二选一，留空则用浏览器）
# VNOTES_COOKIES_FILE=

# === 输出 ===
# 笔记 HTML 与截图/切片的输出根目录（默认 ./output）
# VNOTES_OUTPUT_DIR=./output
# 运行缓存（音频/转写JSON/帧）目录（默认 ./cache）
# VNOTES_CACHE_DIR=./cache
